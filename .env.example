# ── VRK Partners — приклад змінних оточення ───────────────────────────────
# Скопіюйте у .env.local та заповніть. У демо-режимі форми працюють без них.

# Базовий URL продакшну (для SEO / OG / sitemap)
NEXT_PUBLIC_SITE_URL=https://vrkpartners.com

# Cloudflare Turnstile (антибот-капча у формах) — опційно у демо.
# Де взяти: Cloudflare Dashboard → Turnstile → Add widget (тип Managed),
# Domains: ваш домен + localhost (для тесту).
# Тестові «always pass» ключі для локалки:
#   Site: 1x00000000000000000000AA   Secret: 1x0000000000000000000000000000000AA
# Якщо не задані — форми працюють без капчі.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Telegram-сповіщення про заявки (для робочих інтеграцій — поза цим обсягом)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CRM / пошта (поза обсягом демо)
KEYCRM_API_KEY=
RESEND_API_KEY=

# Аналітика
NEXT_PUBLIC_GTM_ID=
