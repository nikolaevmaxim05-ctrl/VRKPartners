# ============================================================
# .env.example — шаблон змінних середовища (VRK Partners)
# Скопіюй у .env.local і заповни реальними значеннями.
# НЕ КОММІТЬ .env.local у репозиторій!
# ============================================================

# --- Next.js ---
NEXT_PUBLIC_SITE_URL=https://vrkpartners.com

# --- Supabase (база даних адмінки) ---
# Проєкт vrk-partners (eu-central-1). URL і ключі — з Settings → API.
# anon — публічний (для клієнтських сесій); service_role — секретний,
# тільки на сервері (обходить RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Cron secret (Vercel Cron → /api/cron/keepalive) ---
# Захищає cron-ендпоінт keepalive (пінг Supabase раз на 5 днів, щоб проєкт
# не засинав на безкоштовному тарифі). Vercel автоматично шле цей секрет
# у заголовку Authorization: Bearer <CRON_SECRET> для запланованих cron-задач.
# Згенеруй: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_64_char_hex_secret_here

# --- Admin master encryption (AES-256-GCM) ---
# 64-символьний hex (32 байти). Шифрує API-ключі інтеграцій у таблиці
# integrations (Telegram token, KeyCRM key, Resend key, Google Sheets SA JSON).
# Згенеруй: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# УВАГА: якщо втратиш цей ключ — всі збережені інтеграції стануть нечитаємими.
# Зберігай у Bitwarden/1Password + Vercel env (Production + Preview).
ADMIN_ENCRYPTION_KEY=your_64_char_hex_key_here

# --- SEO: верифікація пошукових систем ---
# Google Search Console: https://search.google.com/search-console
GOOGLE_VERIFICATION=your_google_verification_token_here
# Bing Webmaster Tools: https://www.bing.com/webmasters
BING_VERIFICATION=your_bing_verification_token_here
# ⛔ Яндекс.Вебмастер НЕ підключаємо (заборонено)

# --- Upstash Redis (rate limiting) ---
# Отримати на: https://console.upstash.com/ → Create Database → Region: eu-west-1
# REST URL та REST Token з розділу "REST API"
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ============================================================
# ІНТЕГРАЦІЇ — налаштовуються З АДМІНКИ (/admin/integrations,
# зберігаються зашифровано в БД). Env нижче — лише fallback для dev.
# ============================================================

# --- Telegram Bot ---
# Створити бота через @BotFather, отримати chat_id через @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- KeyCRM (CRM, Україна) ---
# Отримати на: https://app.keycrm.app/ → Налаштування → API
KEYCRM_API_KEY=
KEYCRM_PIPELINE_ID=

# --- Email через Gmail SMTP (nodemailer) ---
# Налаштовується з адмінки (/admin/integrations → Email (Gmail SMTP)); env — dev-фолбек.
# ВАЖЛИВО: SMTP_PASSWORD — це App Password Google (Акаунт Google → Безпека →
# Двоетапна автентифікація → Паролі додатків), а НЕ звичайний пароль акаунта.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VRK Partners <team@gmail.com>
# Адресат нотифікацій про заявки (не секрет)
NOTIFICATION_EMAIL=

# --- Google Sheets (CRM offline conversions export) ---
# Підключати через адмінку: /admin/settings → Інтеграції Google Sheets.
# Service account JSON: створи у GCP → IAM → Service Accounts → Key → JSON,
# потім поділись таблицею з адресою client_email (Editor).
# GOOGLE_SERVICE_ACCOUNT_JSON має бути ОДНИМ рядком (escape \n у private_key).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=

# ============================================================
# АНАЛІТИКА
# ⛔ ЗАБОРОНЕНО: Яндекс.Метрика, VK Pixel, Mail.ru/myTarget, Top.Mail.ru
# ============================================================

# --- Google Tag Manager ---
# Формат: GTM-XXXXXXX. Якщо порожній — GTM не завантажується (no-op).
# Всі пікселі (GA4, Meta Pixel, TikTok Pixel) підключаються ВСЕРЕДИНІ GTM.
# Прод-теги краще налаштовувати з адмінки: /admin/settings → Tracking-теги.
NEXT_PUBLIC_GTM_ID=

# --- Google Analytics 4 ---
# Підключається через GTM (тег GA4 Configuration).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# --- Plausible Analytics (EU, privacy-first, cookie-free) ---
# Якщо порожній — скрипт Plausible не завантажується.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Meta (Facebook) Pixel / TikTok Pixel ---
# Підключаються через GTM. Env — лише для документації.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
