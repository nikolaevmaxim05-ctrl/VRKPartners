# ============================================================
# .env.example — шаблон переменных окружения (VRK Partners)
# Скопируй в .env.local и заполни реальными значениями.
# НЕ КОММИТЬ .env.local в репозиторий!
# ============================================================

# --- Next.js ---
NEXT_PUBLIC_SITE_URL=https://vrkpartners.com

# --- Supabase (база данных админки) ---
# Проект vrk-partners (eu-central-1). URL и ключи — из Settings → API.
# anon — публичный (для клиентских сессий); service_role — секретный,
# только на сервере (обходит RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Cron secret (Vercel Cron → /api/cron/keepalive) ---
# Защищает cron-эндпоинт keepalive (пинг Supabase раз в 5 дней, чтобы проект
# не засыпал на бесплатном тарифе). Vercel автоматически шлёт этот секрет
# в заголовке Authorization: Bearer <CRON_SECRET> для запланированных cron-задач.
# Сгенерируй: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_64_char_hex_secret_here

# --- Admin master encryption (AES-256-GCM) ---
# 64-символьный hex (32 байта). Шифрует API-ключи интеграций в таблице
# integrations (Telegram token, KeyCRM key, Resend key, Google Sheets SA JSON).
# Сгенерируй: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ВНИМАНИЕ: если потеряешь этот ключ — все сохранённые интеграции станут нечитаемыми.
# Храни в Bitwarden/1Password + Vercel env (Production + Preview).
ADMIN_ENCRYPTION_KEY=your_64_char_hex_key_here

# --- SEO: верификация поисковых систем ---
# Google Search Console: https://search.google.com/search-console
GOOGLE_VERIFICATION=your_google_verification_token_here
# Bing Webmaster Tools: https://www.bing.com/webmasters
BING_VERIFICATION=your_bing_verification_token_here
# ⛔ Яндекс.Вебмастер НЕ подключаем (запрещено)

# --- Rate limiting ---
# Rate-limit формы заявок: не больше 3 заявок с одного IP за 10 минут, считается по
# таблице leads (раздел 8 стандарта) — отдельных env и сервисов НЕ нужно.
# Для тестов на Preview можно временно выключить лимит: RATE_LIMIT_DISABLED=1
# (в Production игнорируется жёстко).
# RATE_LIMIT_DISABLED=

# --- E2E (только тесты) ---
# E2E_CONTENT_OVERRIDES=1 — тесты подставляют контент поверх дефолтов через cookie/файл. НА ПРОДЕ НЕ ЗАДАВАТЬ.
# E2E_ADMIN_EMAIL / E2E_ADMIN_PASSWORD — креденшалы для e2e админки (без них тест пропускается).

# --- GA4 Dev tools: проверка доставки событий (Admin → Settings → Dev tools, шаг 2) ---
# Необязательное. Если не задано — проверка показывает «GA4 не налаштовано» (без ошибки).
# Используйте ОТДЕЛЬНЫЙ тестовый GA4-property, чтобы не засорять продакшн.
#   GA4_MEASUREMENT_ID — G-XXXXXXXXXX (тот же, что на сайте, или тестовый)
#   GA4_API_SECRET     — GA4 → Admin → Data Streams → Measurement Protocol API secrets
#   GA4_PROPERTY_ID    — числовой ID property (GA4 → Admin → Property Settings)
#   GA4_SA_JSON        — JSON сервис-аккаунта (Google Cloud) с ролью Viewer на этом property;
#                        весь JSON одной строкой (private_key с \n). Нужен GA4 Data API.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GA4_PROPERTY_ID=
GA4_SA_JSON=

# ============================================================
# ИНТЕГРАЦИИ — настраиваются ИЗ АДМИНКИ (/admin/integrations,
# хранятся зашифрованно в БД). Env ниже — только fallback для dev.
# ============================================================

# --- Telegram Bot ---
# Создать бота через @BotFather, получить chat_id через @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- KeyCRM (CRM, Украина) ---
# Получить на: https://app.keycrm.app/ → «Налаштування» → API
KEYCRM_API_KEY=
KEYCRM_PIPELINE_ID=

# --- Email через Gmail SMTP (nodemailer) ---
# Настраивается из админки (/admin/integrations → Email (Gmail SMTP)); env — dev-фолбэк.
# ВАЖНО: SMTP_PASSWORD — это App Password Google (Аккаунт Google → Безопасность →
# Двухэтапная аутентификация → Пароли приложений), а НЕ обычный пароль аккаунта.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VRK Partners <team@gmail.com>
# Адресат уведомлений о заявках (не секрет)
NOTIFICATION_EMAIL=

# --- Google Sheets (CRM offline conversions export) ---
# Подключать через админку: /admin/settings → «Інтеграції Google Sheets».
# Service account JSON: создай в GCP → IAM → Service Accounts → Key → JSON,
# потом поделись таблицей с адресом client_email (Editor).
# GOOGLE_SERVICE_ACCOUNT_JSON должен быть ОДНОЙ строкой (escape \n в private_key).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=

# ============================================================
# АНАЛИТИКА
# ⛔ ЗАПРЕЩЕНО: Яндекс.Метрика, VK Pixel, Mail.ru/myTarget, Top.Mail.ru
# ============================================================

# --- Google Tag Manager ---
# Формат: GTM-XXXXXXX. Если пустой — GTM не загружается (no-op).
# Все пиксели (GA4, Meta Pixel, TikTok Pixel) подключаются ВНУТРИ GTM.
# Прод-теги лучше настраивать из админки: /admin/settings → Tracking-теги.
NEXT_PUBLIC_GTM_ID=

# --- Google Analytics 4 ---
# Подключается через GTM (тег GA4 Configuration).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# --- Plausible Analytics (EU, privacy-first, cookie-free) ---
# Если пустой — скрипт Plausible не загружается.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Meta (Facebook) Pixel / TikTok Pixel ---
# Подключаются через GTM. Env — только для документации.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
